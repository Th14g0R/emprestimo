# ------------------------------------------------------------------
# Sistema Emprestimo - exemplos de configuração
# Não coloque senhas/chaves reais neste arquivo versionado.
# ------------------------------------------------------------------

# Diretório persistente de banco/chave.
# EMPRESTIMO_DATA_DIR=/caminho/persistente/data

# Pode substituir apenas o arquivo do banco, se necessário.
# EMPRESTIMO_DATABASE=/caminho/persistente/emprestimos.db

# Em produção prefira definir SECRET_KEY pelo painel do provedor.
# SECRET_KEY=gere-uma-chave-aleatoria-grande

# HTTPS / proxy
# EMPRESTIMO_HTTPS=1
# EMPRESTIMO_BEHIND_PROXY=1

# Domínios/hosts permitidos, separados por vírgula.
# Exemplo:
# EMPRESTIMO_TRUSTED_HOSTS=emprestimo.exemplo.com,www.emprestimo.exemplo.com

# Somente para "python app.py" em desenvolvimento.
# EMPRESTIMO_HOST=127.0.0.1
# EMPRESTIMO_PORT=5000
# EMPRESTIMO_DEBUG=0
