// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id            String    @id @default(cuid())
  nome          String
  telefone      String
  email         String    @unique
  cpf           String    @unique
  endereco      String?
  cidade        String?
  estado        String?
  cep           String?
  observacoes   String?
  status        String    @default("ativo") // ativo, inativo
  
  emprestimos   Emprestimo[]
  cartoes       CartaoCredito[]
  
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@map("clientes")
}

model Emprestimo {
  id                      String    @id @default(cuid())
  cliente_id              String
  cliente                 Cliente   @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  
  descricao               String
  data_emprestimo         DateTime
  valor_original          Float
  saldo_atual             Float
  taxa_juros_mensal       Float     // Ex: 8 = 8%
  data_primeiro_vencimento DateTime
  dia_vencimento          Int       // 1-31
  status                  String    @default("ativo") // ativo, quitado, vencido
  
  movimentacoes           MovimentacaoEmprestimo[]
  
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  @@map("emprestimos")
}

model MovimentacaoEmprestimo {
  id              String    @id @default(cuid())
  emprestimo_id   String
  emprestimo      Emprestimo @relation(fields: [emprestimo_id], references: [id], onDelete: Cascade)
  
  tipo            String    // EMPRESTIMO, JUROS, ABATIMENTO, QUITACAO
  data_movimento  DateTime
  valor           Float
  observacao      String?
  
  created_at      DateTime  @default(now())

  @@map("movimentacoes_emprestimo")
}

model CartaoCredito {
  id                String              @id @default(cuid())
  cliente_id        String
  cliente           Cliente             @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  
  descricao         String
  
  lancamentos       LancamentoCartao[]
  
  created_at        DateTime            @default(now())

  @@map("cartoes_credito")
}

model LancamentoCartao {
  id                    String              @id @default(cuid())
  cartao_credito_id     String
  cartao_credito        CartaoCredito       @relation(fields: [cartao_credito_id], references: [id], onDelete: Cascade)
  
  descricao             String
  valor_total           Float
  quantidade_parcelas   Int
  data_compra           DateTime
  
  parcelas              ParcelaCartao[]
  
  created_at            DateTime            @default(now())

  @@map("lancamentos_cartao")
}

model ParcelaCartao {
  id                    String              @id @default(cuid())
  lancamento_cartao_id  String
  lancamento_cartao     LancamentoCartao    @relation(fields: [lancamento_cartao_id], references: [id], onDelete: Cascade)
  
  numero_parcela        Int
  valor                 Float
  vencimento            DateTime
  data_pagamento        DateTime?
  status                String              @default("pendente") // pendente, pago, vencido

  @@map("parcelas_cartao")
}
